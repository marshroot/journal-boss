# Jornal local development configuration (Docker Compose)
# Open the site at http://localhost:3000
JOURNAL_VERSION=v23-P75

JWT_KEY=replace-with-a-random-secret-of-at-least-32-characters
CORS_ORIGIN=http://localhost:3000

# Optional integrations
JUDGE0_URL=http://host.docker.internal:2358
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_SERVER_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey_replace_me
LIVEKIT_API_SECRET=devsecret_replace_me
LIVEKIT_TOKEN_TTL_SECONDS=7200
APPLICATION_KEY=
MYSTAT_RATE_LIMIT_MS=0

# First administrator. Created only if the database has no user with this login.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# Leave empty to use same-origin /collab through the frontend nginx proxy.
VITE_COLLAB_URL=
